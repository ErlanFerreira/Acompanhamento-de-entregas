# Copie para ".env" nesta mesma pasta e preencha com valores reais.
# Não commitar o ".env" preenchido (já está no .gitignore).

# Postgres (produção: string de conexão da Neon -- use a versão "pooled",
# com "-pooler" no host, recomendada para funções serverless da Vercel).
# Localmente, se deixar em branco, usa um arquivo SQLite (local.db) para testes.
DATABASE_URL=

# Chave para assinar o cookie de sessão -- gere uma string aleatória longa.
SECRET_KEY=troque-por-uma-string-aleatoria-longa

# Login/senha do PORTAL Webtrans (não a API GW Serviços -- essa API só
# enxerga cargas onde o CNPJ logado é remetente/destinatário, não a operação
# completa da empresa; ver HANDOFF.md). A sincronização automatiza o login
# no portal e a geração do relatório personalizado "Pendências".
PORTAL_EMAIL=
PORTAL_SENHA=

# Janela de dias (por emissão do CT-e) buscada em cada sincronização.
# Usada pelo workflow do GitHub Actions (.github/workflows/sync.yml), que
# roda a sincronização periódica (só ele tem o navegador automatizado
# instalado -- ver requirements-sync.txt).
SYNC_WINDOW_DAYS=90

# Primeiro usuário administrador, criado automaticamente na primeira
# inicialização se ainda não existir nenhum usuário no banco.
ADMIN_EMAIL=admin@transrota.com.br
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NOME=Administrador

# Para o botão "Atualizar agora" do painel disparar a sincronização via
# GitHub Actions (a Vercel não roda o navegador automatizado diretamente).
# GITHUB_DISPATCH_TOKEN precisa de um PAT (fine-grained ou classic com
# escopo "workflow") do repositório.
GITHUB_REPO=usuario/nome-do-repositorio
GITHUB_DISPATCH_TOKEN=
